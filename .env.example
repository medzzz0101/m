# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in any keys you have. ALL keys are OPTIONAL.
# The engine runs fully without them — keys only UNLOCK extra (still public /
# self-exposure) capabilities. Never commit your real .env (it is gitignored).
# ---------------------------------------------------------------------------

# Etherscan-style API key — unlocks the eth_explorer module (EVM on-chain).
# Free tier: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Have I Been Pwned API key — unlocks breach lookup for YOUR OWN / authorized
# email only. The k-anonymity password check works WITHOUT a key.
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Stripe secret key — enables REAL subscription checkout. Without it, the
# upgrade flow runs in safe "demo" mode (no real payment). Card data is handled
# only by Stripe's hosted checkout, never by this server.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Server bind config (defaults are fine for this cloud environment).
HOST=0.0.0.0
PORT=8000
