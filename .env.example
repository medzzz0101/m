# ---------------------------------------------------------------------------
# Copy this file to `.env` (local) or set these in your host's dashboard
# (Render / Fly / Railway). ALL keys are OPTIONAL — LATTICE runs fully without
# them. They only enable REAL payments; otherwise checkout runs in demo mode.
# Never commit your real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Crypto receiving addresses (enable real, on-chain-verified payments) ---
# Payments are confirmed directly on the public blockchain — no third-party
# processor. Leave blank to keep demo mode.
PAY_ADDRESS_BTC=
PAY_ADDRESS_ETH=          # this address also receives USDT (ERC-20)

# --- PayPal ---
# Just your paypal.me username (e.g. "janedoe" for paypal.me/janedoe).
PAYPAL_ME=

# --- Server bind (most hosts inject PORT automatically) ---
HOST=0.0.0.0
PORT=8000
