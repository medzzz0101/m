# ---- Footprint Checker backend config ----
# Copia questo file in `.env` e compila i valori.
# IMPORTANT: la chiave HIBP vive SOLO qui, lato server. Mai nel frontend.

# Chiave API Have I Been Pwned (a pagamento): https://haveibeenpwned.com/API/Key
# Se vuota, l'endpoint email gira in MODALITA' DEMO con dati fittizi.
HIBP_API_KEY=

# Porta del server
PORT=3000

# Numero di scansioni gratuite per visitatore (lato demo, in-memory)
FREE_SCANS=2

# User-Agent richiesto dalle API HIBP (metti qualcosa che ti identifica)
HIBP_USER_AGENT=FootprintChecker-SelfCheck
