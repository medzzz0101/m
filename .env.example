# ---------------------------------------------------------------------------
# Copy to `.env` (local) or set in your host's dashboard (Render / Fly / Railway).
# The app ships with working defaults; override here to use YOUR own values.
# Never commit your real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Crypto receiving addresses (real, on-chain-verified payments) ---
# Confirmed directly on the public blockchain — no third-party processor.
PAY_ADDRESS_BTC=bc1q6cp3n3dsss42cqajm53fftgq566vryzqc2g8h7
PAY_ADDRESS_ETH=0x70CE2a516651d7044f1233515963423caB68104b
PAY_ADDRESS_USDC=0x70CE2a516651d7044f1233515963423caB68104b   # ERC-20 USDC

# --- PayPal (optional) — just the paypal.me username ---
PAYPAL_ME=

# --- License keys: owner-issued codes that unlock a tier, reusable forever ---
# Format: CODE:tier, comma-separated. CHANGE THESE — the defaults are public.
# Hand a code to a customer; they paste it in checkout and get the tier instantly.
LICENSE_KEYS=LIMBO-MASTER-K0VFN:master,LIMBO-ELITE-613HM:elite,LIMBO-PREMIUM-Y1D3M:premium

# --- Owner panel: secret token to access /admin (CHANGE THIS) ---
ADMIN_TOKEN=limbo-owner-b5b58ce1a2dbb734

# --- Server bind (most hosts inject PORT automatically) ---
HOST=0.0.0.0
PORT=8000
